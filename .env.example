DJANGO_SECRET_KEY=generate-a-secure-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/snailstamp
REDIS_URL=redis://127.0.0.1:6379/1

# Storage Configuration
# Set USE_S3=True to use S3 storage (production)
USE_S3=False
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=  # Optional: CloudFront CDN domain
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
